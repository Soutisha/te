# AUTONEXUS local configuration example. Copy to .env and replace required values.
# Never commit .env or put real credentials in this example file.

# Required: generate a fresh value with secrets.token_urlsafe(48), at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Required for owner login. Generate the PBKDF2 hash using autonexus.auth.hash_pw.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=

# Keep the included CSV dataset labeled correctly.
DATA_PROVENANCE=synthetic
OFFLINE_MODE=1

# Default local database. For PostgreSQL, set a SQLAlchemy URL in this variable.
AUTONEXUS_DB_URL=sqlite:///autonexus_core.db

# Optional read-only telemetry adapter. URL must serve the documented schema 1.0 JSON.
# Blank means use the built-in synthetic CSV snapshot.
TELEMETRY_URL=
TELEMETRY_TOKEN=

# Optional self-hosted OSRM endpoint. Blank means route on the local road_network.csv graph.
OSRM_URL=


# Local multilingual Whisper model directory (download once; no runtime API).
WHISPER_MODEL_PATH=models/faster-whisper-base

# Optional path to a local Tesseract executable for scanned image / PDF OCR.
TESSERACT_CMD=
